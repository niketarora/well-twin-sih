# FastAPI Server Settings
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://well-twin-sih.vercel.app"]

# Supabase PostgreSQL Settings
# To connect directly to your live Supabase project:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key
# SUPABASE_DB_URL=postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# If SUPABASE_DB_URL is unset, the system automatically uses async SQLite for local development:
DATABASE_URL=sqlite+aiosqlite:///./well_twin.db
